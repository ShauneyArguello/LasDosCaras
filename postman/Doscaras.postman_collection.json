            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"side\": {\n    \"title\": \"Pro free trade (updated)\",\n    \"description\": \"Free trade agreements boost overall economic growth and consumer choice.\",\n    \"sources\": [\n      { \"type\": \"LINK\", \"url\": \"https://example.com/article\", \"label\": \"Economist analysis\" }\n    ]\n  },\n  \"counterpart\": {\n    \"title\": \"Protectionism protects jobs\",\n    \"description\": \"Tariffs shield domestic industries from being undercut.\",\n    \"sources\": [\n      { \"type\": \"YOUTUBE\", \"url\": \"https://youtube.com/watch?v=abc123\", \"label\": \"Explainer video\" }\n    ]\n  },\n  \"hashtags\": [\"freetrade\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/views/{{viewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "views", "{{viewId}}"]
