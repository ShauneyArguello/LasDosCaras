{
  "info": {
    "name": "Doscaras API",
    "description": "REST API for Doscaras (political views / debate platform). Base URL, auth tokens, and entity IDs are stored as collection variables and auto-populated by test scripts on the Auth/Create requests — run requests top-to-bottom on a fresh environment.\n\nFlow: Register -> Activate Account (uses the activationToken returned by Register) -> Login. Registered accounts start as PENDING and cannot log in until activated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d0scaras-api-collection-0001"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "activationToken", "value": "", "type": "string" },
    { "key": "superadminEmail", "value": "admin@doscaras.dev", "type": "string" },
    { "key": "superadminPassword", "value": "ChangeMe123!", "type": "string" },
    { "key": "superadminToken", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "viewId", "value": "", "type": "string" },
    { "key": "threadId", "value": "", "type": "string" },
    { "key": "commentId", "value": "", "type": "string" }
