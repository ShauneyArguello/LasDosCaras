                { "key": "sort", "value": "recent", "description": "likes | dislikes | recent" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "autorId", "value": "", "description": "optional authorId (uuid) filter", "disabled": true },
